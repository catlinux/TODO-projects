# Copia este archivo a .env (permisos 600) y rellena los valores. Nunca se sube a git.

POSTGRES_USER=todo
POSTGRES_PASSWORD=
POSTGRES_DB=todo

# Dirección donde publica el contenedor web. Detrás de un proxy del host:
# 127.0.0.1:PUERTO. Sin esta variable publica en todas las interfaces, puerto 80.
WEB_PORT=127.0.0.1:8083

# Avisos por correo (opcional; sin SMTP_HOST el canal queda desactivado)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=

# Avisos push del navegador (opcional; hacen falta las tres)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 1 arranca el bucle de avisos, 0 lo desactiva
AVISOS_ACTIVOS=1
